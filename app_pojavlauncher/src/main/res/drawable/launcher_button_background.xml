<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_12sdp"/>
            <solid android:color="@color/surface_card_pressed"/>
            <stroke android:width="1dp" android:color="@color/accent_purple"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/_12sdp"/>
            <solid android:color="@color/surface_card"/>
            <stroke android:width="1dp" android:color="#2D253A"/>
        </shape>
    </item>
</selector>