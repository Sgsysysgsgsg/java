<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_app">

    <LinearLayout
        android:id="@+id/launcher_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/_18sdp"
        android:paddingTop="@dimen/_12sdp"
        android:paddingEnd="@dimen/_18sdp"
        android:paddingBottom="@dimen/_8sdp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/launcher_logo"
            android:layout_width="@dimen/_58sdp"
            android:layout_height="@dimen/_58sdp"
            android:contentDescription="@string/app_short_name"
            android:src="@drawable/ic_eyad_logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_10sdp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/launcher_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_short_name"
                android:textColor="@color/primary_text"
                android:textSize="@dimen/_18ssp"
                android:fontFamily="@font/noto_sans_bold" />

            <TextView
                android:id="@+id/launcher_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/launcher_tagline"
                android:textColor="@color/secondary_text"
                android:textSize="@dimen/_9ssp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/launcher_actions"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/_18sdp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/launcher_header"
        app:layout_constraintBottom_toTopOf="@id/_background_display_view"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/auto_setup_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:drawableStart="@drawable/ic_px_settings"
            android:text="@string/auto_setup_title" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/mods_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:drawableStart="@drawable/ic_px_puzzle"
            android:text="@string/mods_title" />

        <com.kdt.mcgui.LauncherMenuButton
            android:id="@+id/open_files_button"
            style="@style/LauncherMenuButton.Universal"
            android:layout_width="match_parent"
            android:drawableStart="@drawable/ic_px_folder"
            android:text="@string/mcl_button_open_directory" />
    </LinearLayout>

    <View
        android:id="@+id/_background_display_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/background_bottom_bar"
        android:translationZ="-1dp"
        app:layout_constraintTop_toTopOf="@id/mc_version_spinner"
        app:layout_constraintBottom_toBottomOf="parent" />

    <com.kdt.mcgui.mcVersionSpinner
        android:id="@+id/mc_version_spinner"
        android:layout_width="0dp"
        android:layout_height="@dimen/_34sdp"
        android:layout_marginStart="@dimen/_12sdp"
        android:layout_marginBottom="@dimen/_8sdp"
        android:background="@android:color/transparent"
        android:drawableEnd="@drawable/spinner_arrow"
        app:drawableEndSize="@dimen/_12sdp"
        app:drawableStartIntegerScaling="true"
        app:drawableStartSize="@dimen/_30sdp"
        app:drawableEndPadding="@dimen/_1sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/edit_profile_button" />

    <ImageButton
        android:id="@+id/edit_profile_button"
        android:layout_width="@dimen/_34sdp"
        android:layout_height="@dimen/_34sdp"
        android:layout_marginEnd="@dimen/_8sdp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/app_short_name"
        android:src="@drawable/ic_px_edit"
        app:layout_constraintBottom_toBottomOf="@id/mc_version_spinner"
        app:layout_constraintEnd_toStartOf="@id/play_button"
        app:layout_constraintTop_toTopOf="@id/mc_version_spinner" />

    <com.kdt.mcgui.MineButton
        android:id="@+id/play_button"
        android:layout_width="@dimen/_150sdp"
        android:layout_height="@dimen/_42sdp"
        android:layout_marginEnd="@dimen/_12sdp"
        android:text="@string/main_play"
        android:textAllCaps="false"
        app:layout_constraintBottom_toBottomOf="@id/mc_version_spinner"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/mc_version_spinner" />

</androidx.constraintlayout.widget.ConstraintLayout>
